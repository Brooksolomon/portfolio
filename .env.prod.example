# Production env for the docker-compose stack.
# Copy to .env.prod and fill in. NEVER commit .env.prod.

# Your domain (DNS A record must point at the VPS IP). Only needed for the
# standalone Caddyfile deploy path — not used with docker-compose.shared.yml.
DOMAIN=yourdomain.com

# ---- Database (dockerized Postgres, runs in the stack) ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=portfolio

# ---- Admin auth (single hardcoded admin account) ----
ADMIN_EMAIL=your-admin-email@example.com
# bcrypt hash of the admin password — generate once with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" 'your-password'
# Docker Compose expands $VAR syntax when reading this file, and bcrypt
# hashes contain literal $ characters — escape each one as $$ or the hash
# gets silently corrupted (e.g. $2a$10$abc... -> $$2a$$10$$abc...).
ADMIN_PASSWORD_HASH=
# Long random string used to sign session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (hex output has no $, so no escaping needed here)
SESSION_SECRET=
